# Platform / runtime (edit .env; restart process — not editable from UI in v0)
HOST=0.0.0.0
PORT=8787
SECRET_KEY=change-me
OFFICE_API_TOKEN=change-me

# Paths
# Local:  OFFICE_REPO_PATH=./office
# Docker: compose sets OFFICE_REPO_PATH=/office and OPENAI_COMPATIBLE_BASE_URL
OFFICE_REPO_PATH=./office
OFFICE_UI_PATH=./apps/office-ui
DATABASE_URL=sqlite:///./data/office.db

# OpenAI-compatible stack (Ollama / vLLM / LM Studio — switch via URL only)
# Prefer …/v1; host-only (…:11434) is normalized to …/v1 by the adapter.
# OLLAMA_BASE_URL is still accepted as an alias.
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# Desk chat / office soft jobs HTTP timeout (seconds)
OPENAI_COMPATIBLE_TIMEOUT=300
# Stacks model pull stream timeout (seconds)
OLLAMA_PULL_TIMEOUT=600

# Memory / HITL
PACK_TOKEN_BUDGET=8000
GOLD_MAX_CHARS=64000
OKF_EXTRACT_ENABLED=true
# Soft office LLM (OKF extract + optional Office Q&A phrasing) — not desk agent.model
OFFICE_MODEL=llama3.2
# Optional LLM phrasing for office knowledge answers (still cite-bound)
OFFICE_QA_LLM=false
# Desk chat: pack recent channel history (days; 0=off)
RECENT_HISTORY_DAYS=7
RECENT_HISTORY_CHAR_BUDGET=6000
APPROVER_MODE=permissive
# Community: one admin. Multi-user header still works; lock-to-single-user switch later.
ORG_ADMINS=admin
