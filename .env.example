# Platform / runtime (edit .env; restart process — not editable from UI in v0)
HOST=0.0.0.0
PORT=8787
SECRET_KEY=change-me
OFFICE_API_TOKEN=change-me

# Paths
# Local:  OFFICE_REPO_PATH=./office
# Docker: compose sets OFFICE_REPO_PATH=/office and OLLAMA_BASE_URL=http://ollama:11434
OFFICE_REPO_PATH=./office
OFFICE_UI_PATH=./apps/office-ui
DATABASE_URL=sqlite:///./data/office.db

# Stacks (chat wired in a later phase)
# Local uvicorn → host Ollama; Docker compose overrides to http://ollama:11434
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Memory / HITL (used in later phases)
PACK_TOKEN_BUDGET=8000
APPROVER_MODE=permissive
